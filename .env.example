# Copy to `.env` next to the Compose files: `cp .env.example .env`.
#
# Compose uses this file twice:
#   1. to interpolate the `${...}` values below into the Compose files
#   2. as the relay container's env_file, so optional DB_* / OAUTH_* / RELAY_*
#      settings below actually reach the process

# Domain used by the HTTPS entry (compose.tls.yml). Raw hostname only.
RELAY_DOMAIN=relay.example.com

# Image pulled by compose.yml / compose.tls.yml.
#
# WARNING: nothing is published at the default path yet. It is the target
# artifact path of this repository (ghcr.io/azurekiln2333/cloudterminal-relay-server),
# and it becomes pullable only after the first CI release runs (.cnb.yml for
# CNB, .github/workflows/image.yml for GitHub). Until then set RELAY_IMAGE to
# an image you have actually pushed.
#
# Other registries:
#   RELAY_IMAGE=ghcr.io/<owner>/<repo>:<tag>
#   RELAY_IMAGE=docker.cnb.cool/azurekiln/cloudterminal-relay-server:<tag>
RELAY_IMAGE=ghcr.io/azurekiln2333/cloudterminal-relay-server:latest

# Port published by the LAN entry (compose.yml). Keep 8787 to match the docs,
# or change it together with the address you give the phone and the desktop.
RELAY_PORT=8787

# Tag used by the explicit local build override (compose.build.yml). Local only.
RELAY_LOCAL_IMAGE=cloudterminal-relay:local

# Optional account layer (OAuth2 + MySQL). Leave unset to run the relay exactly
# as before, without account login. These reach the container through the
# Compose `env_file` entry; the server README lists the supported names.
# Never commit real credentials here (`.env` is gitignored).
#
# Do not put RELAY_KEY here: the key belongs in the relay-data volume so a
# recreated container or a new server keeps the same registration identity.